# Optional server-side override for the market data API host.
# PRECAP_API_URL=https://openstocks-api.onrender.com

# Optional response cache. Unset simply means every request is computed, so the
# site stays up if the cache is removed.
#
# This is the same Redis instance the API uses. It is a 30MB free tier with
# maxclients 30 and a volatile-lru policy, so keys are namespaced by prefix and
# the two services share it without reading each other's entries -- the API
# writes under "osapi", this site under "osmarkets". Set REDIS_URL as a secret.
# REDIS_URL=
# REDIS_KEY_PREFIX=osmarkets

# WalletConnect Cloud project id for the Trade modal's wallet list
# (https://cloud.reown.com). Public by design: it is inlined into the browser
# bundle at build time. Unset, the modal still works with browser-extension
# wallets (MetaMask, Rabby, Coinbase Wallet) but offers no QR or mobile wallets.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional server-side CoinMarketCap Pro key for tokenized-share market pairs.
# The public feed is used if the key is unset or the Pro request fails.
# CMC_API_KEY=

# On-chain price oracle (contracts/, PreIpoPriceOracle) read by /data-feeds.
# All optional: by default the address, chain and feed adapters come from
# contracts/deployments/<network>.json (mainnet bsc.json first) and the RPC is
# that chain's public endpoint. Set these to override. With no address at all
# the page says the oracle is not deployed and shows how to deploy it.
# ORACLE_RPC_URL=https://bsc-dataseed.bnbchain.org
# ORACLE_ADDRESS=0x...
# ORACLE_CHAIN_ID=56
# ORACLE_EXPLORER_URL=   # optional override, e.g. https://testnet.bscscan.com
